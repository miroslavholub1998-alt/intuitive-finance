---
import {
  getCollection,
  render,
  type CollectionEntry
} from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  navigation,
  type NavigationItem
} from "../../data/navigation";

export async function getStaticPaths() {
  const articles = await getCollection(
    "articles",
    ({ data }) => data.draft !== true
  );
  const articlesBySlug = new Map(
    articles.map((article) => [article.id, article])
  );

  return navigation.flatMap((group) =>
    group.items.map((item) => ({
      params: { slug: item.slug },
      props: {
        item,
        article: articlesBySlug.get(item.slug)
      }
    }))
  );
}

interface Props {
  item: NavigationItem;
  article?: CollectionEntry<"articles">;
}

const { article, item } = Astro.props;
const rendered = article ? await render(article) : undefined;
const Content = rendered?.Content;
const title = article?.data.title ?? item.title;
const description = article?.data.description ?? "";
---

<BaseLayout
  title={title}
  description={description}
  activeSlug={item.slug}
>
  <article class="article">
    <header class="article-header">
      <h1>{title}</h1>
    </header>

    {
      Content && (
        <div class="article-body">
          <Content />
        </div>
      )
    }
  </article>
</BaseLayout>
